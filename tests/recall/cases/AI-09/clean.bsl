Процедура ЗаполнитьСтавкиНДС(Знач ДокументОбъект) Экспорт

	Если ДокументОбъект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтавкаПоУмолчанию = Константы.СтавкаНДСПоУмолчанию.Получить();

	Для Каждого СтрокаТоваров Из ДокументОбъект.Товары Цикл

		СтрокаТоваров.СтавкаНДС = СтавкаПоУмолчанию;
		СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;

	КонецЦикла;

КонецПроцедуры
