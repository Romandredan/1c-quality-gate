// Возвращает запись очереди в работу кнопкой «Повторить» формы списка.
// К сервису не обращается - отправку выполнит регламентное задание.
Функция ПовторитьЗапись(Основание) Экспорт

	НаборЗаписей = РегистрыСведений.Возвраты_ОчередьОпераций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Основание.Установить(Основание);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Запись очереди не найдена.'");
	КонецЕсли;

	Запись = НаборЗаписей[0];
	Если Запись.Состояние = Перечисления.Возвраты_СостоянияОчереди.Новый Тогда
		Возврат НСтр("ru = 'Запись уже в работе.'");
	КонецЕсли;

	// Возврат уже отражён в учёте: запись снимается, а не повторяется.
	Если ВозвратОтраженВУчете(Запись.Основание) Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		Возврат НСтр("ru = 'Возврат уже отражён в учёте: запись снята с очереди.'");
	КонецЕсли;

	// Возврат выполнен сервисом, отражение не удалось: чиним восстановлением из буфера.
	Если СтрНайти(Запись.Комментарий, ТекстВозвратВыполненСервисом()) > 0 Тогда
		Возврат ОтразитьВозвратИзБуфера(Запись);
	КонецЕсли;

	// Исход предыдущей отправки неизвестен (таймаут, неразобранный ответ): запрос мог
	// уйти и исполниться. Повторная отправка без сверки дала бы второй возврат -
	// сначала ищем выполненную операцию в буфере загрузки транзакций.
	Если СтрНайти(Запись.Комментарий, ТекстНеизвестныйИсход()) > 0 Тогда
		НайденныйВозврат = ТранзакцииВозвратаИзБуфера(Запись.ИдентификаторТранзакции);
		Если НайденныйВозврат.Количество() = 0 Тогда
			Возврат НСтр("ru = 'Исход предыдущей отправки неизвестен: повтор доступен после сверки с сервисом.'");
		КонецЕсли;
		Возврат ОтразитьВозвратИзБуфера(Запись);
	КонецЕсли;

	// Определённый отказ сервиса: повтор безопасен.
	Запись.Состояние = Перечисления.Возвраты_СостоянияОчереди.Новый;
	Запись.КолПопыток = 0;
	НаборЗаписей.Записать();

	Возврат "";

КонецФункции
