Процедура ЗаполнитьСтроку(Знач Строка, Знач Основание, Знач ЦенаВключаетНДС) Экспорт

	Ставка = 20;

	Если Основание.Сумма <= 0 Тогда
		Строка.Цена = 0;
		Строка.Сумма = 0;
		Строка.СуммаНДС = 0;
		Строка.СуммаСНДС = 0;
		Возврат;
	КонецЕсли;

	Строка.Цена = Основание.Сумма;
	Строка.Сумма = Основание.Сумма;
	// Признак режима пришёл параметром, но в расчёт налога не попал: при включённом налоге
	// он должен выделяться из суммы, а не начисляться сверху.
	Строка.СуммаНДС = Окр(Основание.Сумма * Ставка / 100, 2);
	Строка.СуммаСНДС = Основание.Сумма + Строка.СуммаНДС;

КонецПроцедуры
