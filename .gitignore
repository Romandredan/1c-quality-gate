# Состояние гейтов пишется в проект, а не в плагин, но на всякий случай
.state/
*.log

# ОС и редакторы
Thumbs.db
.DS_Store
.vscode/
.idea/

# Node (плагин зависимостей не имеет, но защищаемся от случайного npm i)
node_modules/
package-lock.json

# Python: байт-код валидаторов XML. Появляется от python -m compileall в CI и локально
__pycache__/
*.py[cod]

# Рабочее пространство редактора — локальная вещь
*.code-workspace

# Промежуточный каталог отчёта запасного движка анализатора
.qg-analyzer/

# Рабочие каталоги других плагинов Claude Code: история сессий в репозиторий не попадает
.remember/

# Настройка, которую плагин заводит в проекте пользователя. Здесь она появляется от правок
# XML-фикстур (путь с cf/ выглядит как выгрузка 1С) и к самому плагину отношения не имеет.
# В проектах пользователей файл, наоборот, коммитят — это общая настройка команды.
.1c-quality-gate.json
