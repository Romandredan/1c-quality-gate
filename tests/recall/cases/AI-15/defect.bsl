Функция СоздатьПараметрыЗаписиJSON(Знач Компактно) Экспорт

	// Свойства ПараметрыЗаписиJSON доступны только для чтения после создания
	// объекта без аргументов - присваивание дает ошибку.
	Параметры = Новый ПараметрыЗаписиJSON;

	Если Компактно Тогда
		Параметры.ПереносСтрок = ПереносСтрокJSON.Нет;
	Иначе
		Параметры.ПереносСтрок = ПереносСтрокJSON.Авто;
	КонецЕсли;

	Возврат Параметры;

КонецФункции
