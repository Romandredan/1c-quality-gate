Функция ЕстьТабличнаяЧастьСтроки() Экспорт

	// Табличная часть принадлежит конфигурации, ее не может не быть -
	// проверка "на всякий случай" прячет опечатку под видом штатной ветки.
	ОбъектМетаданных = Метаданные.Документы.РасходДокумент;
	ТабличнаяЧасть = ОбъектМетаданных.ТабличныеЧасти.Найти("Строки");
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТабличнаяЧасть.Реквизиты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции
