Функция ПрочитатьЯчейкуМакета(Знач Макет, Знач НомерСтроки, Знач НомерКолонки) Экспорт

	Если НомерСтроки <= 0 Или НомерКолонки <= 0 Тогда
		Возврат "";
	КонецЕсли;

	// У табличного документа нет метода Получить, а .Значение для текстовой
	// ячейки, пришедшей из внешнего файла, дает ошибку чтения поля.
	Значение = Макет.Получить(НомерСтроки, НомерКолонки);
	ТекстЯчейки = Макет.Область(НомерСтроки, НомерКолонки).Значение;

	Возврат ТекстЯчейки;

КонецФункции
