// Ставит заказ в очередь отправки командой создания плана: очередь отдаёт команду
// регламентному заданию отправки, карточка заказа показывает этап «ждёт постановки».
Процедура ПоставитьЗаказ(УчетнаяЗапись, Заказ)

	Попытка
		ОчередьОтправки.ПоставитьОбъектВОчередьНаВыгрузку(Заказ,
			Перечисления.Обмен_ОперацииAPI.СоздатьПланЗаказа,
			УчетнаяЗапись,
			ОчередьОтправки.СтруктураРеквизитовЗаписиВОчередь());
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказКлиента, Заказ,
			СтрШаблон(НСтр("ru = 'Заказ %1 не поставлен в очередь отправки: %2'"),
				Заказ, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры
