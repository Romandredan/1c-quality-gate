Функция ПроверитьРасширениеПередКоммитом() Экспорт

	// Прогон платформой не выполнялся: правка не трогала тела модулей.
	// [qg not_verified: dimension=compilation, reason=no_platform]

	Отчет = Новый Структура;
	Отчет.Вставить("Статус", "not_verified");
	Отчет.Вставить("Причина", "no_platform");
	Отчет.Вставить("ДатаПроверки", ТекущаяДата());
	Отчет.Вставить("Комментарий", "Правка не трогала тела модулей, прогон платформой не требовался");

	Возврат Отчет;

КонецФункции
