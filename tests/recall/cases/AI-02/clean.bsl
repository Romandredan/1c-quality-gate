Функция ПолучитьВалютуДокумента(Знач ДокументСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;

	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Валюта");

	Если Валюта = Неопределено Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;

	Возврат Валюта;

КонецФункции
