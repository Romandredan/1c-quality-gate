Функция ПодобратьНоменклатуруПоАртикулам(Знач Артикулы) Экспорт

	Таблица = Новый ТаблицаЗначений;
	// Колонка без квалификатора длины - неограниченная строка, ошибка при РАЗЛИЧНЫЕ.
	Таблица.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));

	Для Каждого Артикул Из Артикулы Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Артикул = Артикул;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ &Таблица КАК Артикулы
	|		ПО Номенклатура.Артикул = Артикулы.Артикул";
	Запрос.УстановитьПараметр("Таблица", Таблица);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
