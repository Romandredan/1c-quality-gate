Процедура ОбработатьОчередьВозвратов() Экспорт

	Если Не СредаПодходит() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СредаБазы", СредаБазы());
	Запрос.УстановитьПараметр("Состояния", СостоянияКОбработке());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Основание КАК Основание,
	|	Очередь.Сумма КАК Сумма,
	|	Настройки.clientId КАК clientId,
	|	Настройки.Ключ КАК Ключ
	|ИЗ
	|	РегистрСведений.Возвраты_ОчередьОпераций КАК Очередь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Возвраты_УчетныеЗаписи КАК УчетныеЗаписи
	|		ПО Очередь.УчетнаяЗапись = УчетныеЗаписи.Ссылка
	|			И УчетныеЗаписи.Среда = &СредаБазы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Возвраты_НастройкиПодключения КАК Настройки
	|		ПО УчетныеЗаписи.Склад = Настройки.Склад
	|			И Настройки.ТипБазы = УчетныеЗаписи.Среда.ТипБазы
	|ГДЕ
	|	Очередь.Состояние В(&Состояния)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтправитьВозвратВСервис(Выборка);
	КонецЦикла;

КонецПроцедуры

Функция СредаПодходит()

	ЭтоБоевая = ОбщегоНазначенияСервер.ЭтоБоеваяБД();
	Если Константы.Возвраты_ЭтоРабочаяБаза.Получить() <> ЭтоБоевая Тогда
		ЗаписьЖурналаРегистрации("Возвраты.ОбработкаОчереди", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Признак рабочей базы не совпадает со средой: обработка очереди возвратов пропущена.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции
