Процедура ЗаполнитьОстаткиЗаказов(Знач ДокументОбъект) Экспорт

	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = "ВЫБРАТЬ Номенклатура ИЗ Документ.Заказ.Товары ГДЕ Ссылка = &Ссылка";
	ЗапросЗаказы.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Заказы = ЗапросЗаказы.Выполнить().Выгрузить();

	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура В (&СписокНоменклатуры))";
	ЗапросОстатки.УстановитьПараметр("СписокНоменклатуры", Заказы.ВыгрузитьКолонку("Номенклатура"));
	Остатки = ЗапросОстатки.Выполнить().Выгрузить();

	// Оба набора получены из базы, но связываются в памяти через Соответствие,
	// а не соединением в запросе.
	СоответствиеОстатков = Новый Соответствие;
	Для Каждого СтрокаОстатка Из Остатки Цикл
		СоответствиеОстатков.Вставить(СтрокаОстатка.Номенклатура, СтрокаОстатка.КоличествоОстаток);
	КонецЦикла;

	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Остаток = СоответствиеОстатков.Получить(СтрокаТовара.Номенклатура);
		Если Остаток <> Неопределено Тогда
			СтрокаТовара.Остаток = Остаток;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
