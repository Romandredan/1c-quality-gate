Процедура ПроверитьЗаполнениеСклада(Знач ДокументОбъект, Отказ) Экспорт

	// Привязка к объекту и полю - пользователь видит, где именно ошибка,
	// плюс диагностика для разбора инцидентов - в журнал регистрации.
	Если Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен склад", , "Объект.Склад", , Отказ);
		ЗаписьЖурналаРегистрации("Учет.ПроверкаЗаполнения", УровеньЖурналаРегистрации.Предупреждение, , , "Не заполнен склад");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнена организация", , "Объект.Организация", , Отказ);
		ЗаписьЖурналаРегистрации("Учет.ПроверкаЗаполнения", УровеньЖурналаРегистрации.Предупреждение, , , "Не заполнена организация");
	КонецЕсли;

КонецПроцедуры
