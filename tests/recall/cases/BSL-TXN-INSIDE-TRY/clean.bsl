Процедура ВыполнитьОперацию(Знач Параметры) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// НачатьТранзакцию() строго до Попытка.
	НачатьТранзакцию();
	Попытка
		ОбработатьДанные(Параметры);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Модуль.ВыполнитьОперацию", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры
