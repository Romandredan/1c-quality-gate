&НаКлиенте
Процедура Обработать(Команда)

	// Три последовательных серверных вызова вместо одного - каждый платит
	// за отдельный клиент-серверный переход.
	Данные1 = ПолучитьДанные1НаСервере();
	Данные2 = ПолучитьДанные2НаСервере();
	Данные3 = ПолучитьДанные3НаСервере();

	Если Данные1 = Неопределено Или Данные2 = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОповеститьОЗавершении(Данные1, Данные2, Данные3);

КонецПроцедуры
