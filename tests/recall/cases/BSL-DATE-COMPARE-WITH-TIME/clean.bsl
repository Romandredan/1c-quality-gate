Процедура ПроверитьДату(Знач Исходник, Знач Параметры, Проверки) Экспорт

	Проверка = Проверки.Добавить();
	Проверка.Название = "Дата отличается от даты исходного события";
	Проверка.Пройдено = Истина;

	// Сравниваются календарные дни: время в исходнике не мешает.
	Если НачалоДня(Параметры.Дата) = НачалоДня(Исходник.ДатаСобытия) Тогда
		Проверка.Пройдено = Ложь;
		Проверка.Пояснение = "Дата совпадает с исходной";
	КонецЕсли;

КонецПроцедуры
