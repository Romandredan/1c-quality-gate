Процедура ЗаполнитьКурсыВалют(Знач ТаблицаДанных, Знач Дата) Экспорт

	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Повторный вызов с теми же параметрами каждый раз выполняет одну и ту же работу.
	Для Каждого Строка Из ТаблицаДанных Цикл
		Строка.Курс = ПолучитьКурсВалюты(Строка.Валюта, Дата);
		Строка.СуммаВВалюте = Строка.Сумма * Строка.Курс;
		Строка.ДатаРасчета = Дата;
	КонецЦикла;

КонецПроцедуры
