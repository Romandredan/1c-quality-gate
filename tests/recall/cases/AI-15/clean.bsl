Функция СоздатьПараметрыЗаписиJSON(Знач Компактно) Экспорт

	Если Компактно = Неопределено Тогда
		Компактно = Ложь;
	КонецЕсли;

	// Значения передаются в конструктор - после создания объекта они read-only.
	Если Компактно Тогда
		Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, Символы.Таб);
	Иначе
		Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	КонецЕсли;

	Возврат Параметры;

КонецФункции
