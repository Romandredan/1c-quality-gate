Процедура ЗаписатьЦеныНоменклатуры(Знач Номенклатура, Знач Цена, Знач ДатаДокумента) Экспорт

	// Отбор по одному измерению: Записать(Истина) удалит все записи по этой номенклатуре
	// за все периоды, а запишет только текущий набор.
	Набор = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Номенклатура);

	НоваяСтрока = Набор.Добавить();
	НоваяСтрока.Период = ДатаДокумента;
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Цена = Цена;

	Набор.Записать(Истина);

КонецПроцедуры
