Функция СопоставитьПоКлючу(Знач Таблица1, Знач Таблица2) Экспорт

	Индекс = Новый Соответствие;
	Для Каждого Строка2 Из Таблица2 Цикл
		Индекс.Вставить(Строка2.Ключ, Строка2);
	КонецЦикла;

	Для Каждого Строка1 Из Таблица1 Цикл
		Строка2 = Индекс.Получить(Строка1.Ключ);
		Если Строка2 <> Неопределено Тогда
			Строка1.Значение = Строка2.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица1;

КонецФункции
