Функция ПолучитьСвойствоКодПартнера() Экспорт

	// Вид характеристики создается кодом при первом обращении - хрупко и ломается
	// при обновлении, зависит от порядка инициализации.
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	Свойство.Наименование = "Код партнера";
	Свойство.ИмяПредопределенныхДанных = "КодПартнера";
	Свойство.ТипЗначения = Новый ОписаниеТипов("Строка");
	Свойство.ЗначенияВыбора.Очистить();
	Свойство.Записать();

	Возврат Свойство.Ссылка;

