Процедура ЗаполнитьКурсыВалют(Знач ТаблицаДанных, Знач Дата) Экспорт

	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КэшКурсов = Новый Соответствие;

	Для Каждого Строка Из ТаблицаДанных Цикл
		Курс = КэшКурсов.Получить(Строка.Валюта);
		Если Курс = Неопределено Тогда
			Курс = ПолучитьКурсВалюты(Строка.Валюта, Дата);
			КэшКурсов.Вставить(Строка.Валюта, Курс);
		КонецЕсли;
		Строка.Курс = Курс;
		Строка.СуммаВВалюте = Строка.Сумма * Курс;
		Строка.ДатаРасчета = Дата;
	КонецЦикла;

КонецПроцедуры
