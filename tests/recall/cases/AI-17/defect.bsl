Функция ПолучитьОчередьЗаданий(Знач Запрос) Экспорт

	Выборка = Запрос.Выполнить().Выбрать();
	Записи = Новый Массив;

	// Список полей задублирован: он есть в тексте запроса и здесь.
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура("Идентификатор, Операция, Основание, Склад, Статус");
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Вставить("Обработана", Ложь);
		Записи.Добавить(Запись);
	КонецЦикла;

	Возврат Записи;

КонецФункции
