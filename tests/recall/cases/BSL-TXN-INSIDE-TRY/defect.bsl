Процедура ВыполнитьОперацию(Знач Параметры) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// ОтменитьТранзакцию() вызовется, даже если НачатьТранзакцию() не выполнилась.
	Попытка
		НачатьТранзакцию();
		ОбработатьДанные(Параметры);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;

КонецПроцедуры
