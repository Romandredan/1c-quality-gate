&НаСервере
Процедура УдалитьОтмеченныеЗаказы()

	Удалённые = Новый Массив;

	Для Каждого Строка Из Объект.ТЧ_Заказы Цикл
		Если Не Строка.Пометка Или Строка.УдалёнВоВнешнейСистеме Тогда
			Продолжить;
		КонецЕсли;

		Результат = ОтправитьУдалениеПланаДокумента(Строка.Заказ, Строка.УчетнаяЗапись);
		Если Результат.Успешно Тогда
			ЗафиксироватьУдалениеПлана(Строка.Заказ, Строка.УчетнаяЗапись);
			Удалённые.Добавить(Строка.Заказ);
		КонецЕсли;
		Строка.УдалёнВоВнешнейСистеме = Результат.Успешно;
		Строка.ТекстОшибки = ?(Результат.Успешно, "", Результат.ТекстОшибки);
	КонецЦикла;

	Если Удалённые.Количество() Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен.УдалениеПланов'"),
			УровеньЖурналаРегистрации.Информация, ,
			Объект.Ссылка,
			СтрШаблон(НСтр("ru = 'Удалено планов во внешней системе: %1. Перечень: %2'"),
				Удалённые.Количество(), СтрСоединить(Удалённые, ", ")));
	КонецЕсли;

КонецПроцедуры
