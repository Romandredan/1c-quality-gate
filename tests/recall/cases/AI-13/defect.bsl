Функция ПолучитьСвойствоКодПартнера() Экспорт

	// Программное имя и пользовательское наименование - разные реквизиты,
	// поиск по наименованию ломается при переименовании заголовка.
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Код партнера");

	Если Свойство = Неопределено Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка();
	КонецЕсли;

	Возврат Свойство;

КонецФункции
