Функция ПолучитьДиагностикуИКандидатов(Знач Запрос) Экспорт

	Если Запрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = Запрос.ВыполнитьПакет();
	// Выглядит как защита от изменения состава, но при вставке запроса в середину
	// пакета расчет молча возьмет не ту таблицу.
	Диагностика = Пакет[Пакет.ВГраница() - 1].Выгрузить();
	Кандидаты = Пакет[Пакет.ВГраница()].Выгрузить();

	Результат = Новый Структура("Диагностика, Кандидаты", Диагностика, Кандидаты);

	Возврат Результат;

КонецФункции
