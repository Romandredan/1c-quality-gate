Процедура ПроверитьЗаполнение(Знач ДокументОбъект, ЕстьПроблемы, ТекстПроблемы) Экспорт

	ЕстьПроблемы = Ложь;
	ТекстПроблемы = "";

	Если Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
		ЕстьПроблемы = Истина;
		ТекстПроблемы = "Не заполнен склад";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		ЕстьПроблемы = Истина;
		ТекстПроблемы = "Не заполнен контрагент";
	КонецЕсли;

КонецПроцедуры
