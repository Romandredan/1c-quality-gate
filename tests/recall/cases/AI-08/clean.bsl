Функция РазобратьОтветЗаказа(Знач Ответ) Экспорт

	ДанныеЗаказа = Новый Структура("Идентификатор, Дата, Сумма");
	ДанныеЗаказа.Идентификатор = Ответ.Свойства.Получить("id");
	ДанныеЗаказа.Дата = XMLЗначение(Тип("Дата"), Ответ.Свойства.Получить("date"));
	ДанныеЗаказа.Сумма = XMLЗначение(Тип("Число"), Ответ.Свойства.Получить("amount"));

	Возврат ДанныеЗаказа;

КонецФункции

Процедура ЗаполнитьДокументПоОтвету(Знач ДокументОбъект, Знач Ответ) Экспорт

	ДанныеЗаказа = РазобратьОтветЗаказа(Ответ);

	ДокументОбъект.НомерВнешний = ДанныеЗаказа.Идентификатор;
	ДокументОбъект.Дата = ДанныеЗаказа.Дата;
	ДокументОбъект.Сумма = ДанныеЗаказа.Сумма;

КонецПроцедуры
