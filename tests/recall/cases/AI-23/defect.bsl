Процедура ОбработатьОчередьВозвратов() Экспорт

	Среда = СредаБазы();
	Если Среда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтоРабочаяБаза", Константы.Возвраты_ЭтоРабочаяБаза.Получить());
	Запрос.УстановитьПараметр("Состояния", СостоянияКОбработке());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Основание КАК Основание,
	|	Очередь.Сумма КАК Сумма,
	|	Настройки.clientId КАК clientId,
	|	Настройки.Ключ КАК Ключ
	|ИЗ
	|	РегистрСведений.Возвраты_ОчередьОпераций КАК Очередь
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Возвраты_НастройкиПодключения КАК Настройки
	|		ПО Очередь.Склад = Настройки.Склад
	|			И Настройки.ТипБазы = &ЭтоРабочаяБаза
	|ГДЕ
	|	Очередь.Состояние В(&Состояния)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтправитьВозвратВСервис(Выборка);
	КонецЦикла;

КонецПроцедуры
