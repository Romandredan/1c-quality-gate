&НаСервереБезКонтекста
Функция ПолучитьДанныеНаСервере(Знач Параметры) Экспорт

	// Контекст формы методу не нужен - нужные данные приходят параметром.
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	РезультатЗапроса = ВыполнитьЗапрос(Параметры);

	Результат = Новый Структура;
	Результат.Вставить("Данные", РезультатЗапроса);
	Результат.Вставить("КоличествоСтрок", РезультатЗапроса.Количество());

	Возврат Результат;

КонецФункции
