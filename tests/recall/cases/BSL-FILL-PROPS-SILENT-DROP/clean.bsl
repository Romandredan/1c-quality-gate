Функция РазобратьОтвет(Знач Ответ) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Вердикт", Неопределено);
	Результат.Вставить("Марка", "");

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Результат.Вставить("Ошибка", "Некорректный ответ");
		Возврат Результат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Результат, Ответ);

	Возврат Результат;

КонецФункции
