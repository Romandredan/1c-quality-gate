// Контр-фикстура контура платформенного API: заведомо корректный код.
//
// Здесь всё существует и вызвано верно: методы Массива и ТаблицыЗначений, число аргументов
// СтрШаблон, значение системного перечисления. Движок ОБЯЗАН промолчать.
//
// Зачем отдельный файл. Проверка, которая только срабатывает, но никогда не молчит, ловит
// не дефекты, а факт своего запуска. Ложная находка вреднее пропущенной: после двух-трёх
// таких проверку отключают целиком — вместе с настоящими находками.
//
// Имена переменных подобраны так, чтобы не совпадать с именами платформенных типов
// (ЗаписьДанных, Соединение, Блокировка, РезультатЗапроса). Совпадение — известный класс
// ложных срабатываний движка: имя переменной перебивает вывод типа из присваивания. Здесь
// он не воспроизводится намеренно, иначе контр-фикстура перестала бы быть чистой.

#Область СлужебныйПрограммныйИнтерфейс

// Существует ради доказательства, что на корректном коде находок нет.
//
Процедура QG_ПодтвердитьМолчаниеНаКорректномКоде() Экспорт

	СписокЗначений = Новый Массив;
	СписокЗначений.Добавить("Первый");
	СписокЗначений.Добавить("Второй");

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Наименование");
	НоваяСтрока = Строки.Добавить();
	НоваяСтрока.Наименование = СписокЗначений[0];

	ВидГруппыОтбора = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;

	Сообщить(СтрШаблон("Строк: %1, элементов: %2, группа: %3",
		Строки.Количество(), СписокЗначений.Количество(), ВидГруппыОтбора));

КонецПроцедуры

#КонецОбласти
