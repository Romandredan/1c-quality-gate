Функция РазобратьОтвет(Знач Ответ) Экспорт

	Результат = Новый Структура("Ошибка");
	Результат.Ошибка = "";

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Результат.Ошибка = "Некорректный ответ";
		Возврат Результат;
	КонецЕсли;

	// В Ответ приходят Вердикт, Марка и Код разбора, а в приёмнике из ключей только Ошибка:
	// остальные значения молча не переносятся.
	ЗаполнитьЗначенияСвойств(Результат, Ответ);

	Возврат Результат;

КонецФункции
