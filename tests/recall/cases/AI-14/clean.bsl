Функция ПрочитатьЯчейкуМакета(Знач Макет, Знач НомерСтроки, Знач НомерКолонки) Экспорт

	Если НомерСтроки <= 0 Или НомерКолонки <= 0 Тогда
		Возврат "";
	КонецЕсли;

	Ячейка = Макет.Область(НомерСтроки, НомерКолонки);
	// .Текст не выбрасывает исключение никогда, пустая ячейка даст пустую строку.
	ТекстЯчейки = Ячейка.Текст;

	Если ПустаяСтрока(ТекстЯчейки) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстЯчейки;

КонецФункции
