Функция ПолучитьДиагностикуИКандидатов(Знач Запрос) Экспорт

	Если Запрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = Запрос.ВыполнитьПакет();

	// Индексы заданы порядком запросов в тексте: 12 запросов, 0-9 - временные таблицы,
	// 10 - диагностика, 11 - результат. Меняются только вместе с текстом запроса.
	Диагностика = Пакет[10].Выгрузить();
	Кандидаты = Пакет[11].Выгрузить();

	Результат = Новый Структура("Диагностика, Кандидаты", Диагностика, Кандидаты);

	Возврат Результат;

КонецФункции
