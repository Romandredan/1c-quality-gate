Функция НайтиСтрокуНабора(Знач Строки, Знач Идентификатор, Знач НомерСтроки, Знач Период) Экспорт

	// Ключ склеен из значений строкой вместо поиска сразу по трем колонкам.
	Ключ = Идентификатор + "|" + Строка(НомерСтроки) + "|" + XMLСтрока(Период);
	Соответствие = Новый Соответствие;

	Для Каждого СтрокаНабора Из Строки Цикл
		КлючСтроки = СтрокаНабора.Идентификатор + "|" + Строка(СтрокаНабора.НомерСтроки)
			+ "|" + XMLСтрока(СтрокаНабора.Период);
		Соответствие.Вставить(КлючСтроки, СтрокаНабора);
	КонецЦикла;

	Возврат Соответствие.Получить(Ключ);

КонецФункции
