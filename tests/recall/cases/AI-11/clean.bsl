Процедура ЗарезервироватьТовар(Знач ДокументОбъект, Знач Номенклатура, Знач Количество) Экспорт

	Если Количество <= 0 Тогда
		Возврат;
	КонецЕсли;

	Остаток = ПолучитьОстаток(Номенклатура, ДокументОбъект.Склад);

	НоваяСтрока = ДокументОбъект.Резервы.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Остаток = Остаток;

	ЗаписатьСледРезервирования(ДокументОбъект.Ссылка, Номенклатура, Количество);

КонецПроцедуры
