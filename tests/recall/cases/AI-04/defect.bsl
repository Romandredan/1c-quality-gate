Функция ПроверитьРасширениеПередКоммитом() Экспорт

	// Проверено: конфигурация собирается, все процедуры компилируются без ошибок.
	// Зарегистрировано в составе конфигурации, дефектов не найдено.

	Отчет = Новый Структура;
	Отчет.Вставить("Статус", "Проверено");
	Отчет.Вставить("Дефектов", 0);
	Отчет.Вставить("ДатаПроверки", ТекущаяДата());
	Отчет.Вставить("Комментарий", "Сборка прошла, все процедуры компилируются без ошибок");

	Возврат Отчет;

КонецФункции
